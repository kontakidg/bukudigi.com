#
# bukudigi.com — Production .env template
# Copy ke `.env` di VPS, lalu isi value-nya.
#

APP_NAME=bukudigi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://bukudigi.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# === Database (MariaDB) ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bukudigi
DB_USERNAME=bukudigi
DB_PASSWORD=GANTI-PASSWORD-KUAT

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=bukudigi

# === Mail SMTP ===
# Gmail App Password setup:
#   1. https://myaccount.google.com → Security → 2-Step Verification (wajib ON)
#   2. https://myaccount.google.com/apppasswords → buat App Password baru
#      Pilih "Mail" + "Other (Custom name)" → kasih nama "bukudigi-vps"
#   3. Copy 16 karakter app password (tanpa spasi), paste di MAIL_PASSWORD
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=kulinerbdgcom@gmail.com
MAIL_PASSWORD="ganti-16-karakter-app-password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="kulinerbdgcom@gmail.com"
MAIL_FROM_NAME="bukudigi"
# Catatan: from address harus sama dengan MAIL_USERNAME (Gmail policy).
# Alias custom (mis. noreply@bukudigi.com) butuh setup "Send mail as"
# di Gmail settings + verifikasi.

# === Cloudflare R2 (private storage — PDF/EPUB master + watermarked) ===
# Setup:
#   1. Cloudflare dashboard → R2 → Create bucket (private, default)
#   2. R2 → Manage API tokens → Create User API Token
#      - Permissions: Object Read & Write
#      - Specify bucket: pilih bucket-nya
#      - Token expires: pilih (kalau ga, default never)
#   3. Copy Account ID, Access Key ID, Secret Access Key
#   4. Endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   5. Set PRIVATE_DISK_DRIVER=s3 untuk aktifkan R2. Kalau 'local', pakai server local.
PRIVATE_DISK_DRIVER=s3
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bukudigi-private
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# === Google OAuth (opsional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# === Fonnte WhatsApp (stub sampai SIM card siap) ===
FONNTE_MODE=stub
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send

# === Facebook (untuk OG fb:app_id tag) ===
# Daftar di https://developers.facebook.com/apps/ → create App → copy App ID.
# Optional — Facebook tetap render OG tanpa ini, cuma kehilangan Insights tracking.
FACEBOOK_APP_ID=

# === Payment Gateway Selector ===
# Values: 'stub' (promo gratis), 'paypal', 'midtrans'
PAYMENT_GATEWAY=stub

# === PayPal (Smart Buttons) ===
# Daftar di https://developer.paypal.com → Create App → ambil client ID + secret.
# Mode: 'sandbox' untuk testing, 'live' untuk production (uang beneran).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# Kurs IDR→USD untuk konversi harga buku (admin update manual periodik).
# Mis. 16000 berarti $1 = Rp 16.000 → buku Rp 50.000 = $3.13
PAYPAL_USD_TO_IDR=16000

# === Midtrans ===
# mode: 'stub' untuk simulasi tanpa Midtrans, 'live' untuk beneran call Snap API.
MIDTRANS_MODE=stub
# is_production: false untuk sandbox (test mode), true untuk production (uang beneran).
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_ENABLE_3DS=true

# Callback URLs — boleh kosong (fallback ke route default).
# Set di dashboard Midtrans Settings → Configuration → Payment Notification URL:
#   https://bukudigi.com/api/midtrans/notify
# Finish URL setelah user complete pembayaran:
MIDTRANS_FINISH_URL=
MIDTRANS_UNFINISH_URL=
MIDTRANS_ERROR_URL=
MIDTRANS_NOTIFY_URL=

# === AI Moderasi (opsional — kalau kosong, admin moderasi manual) ===
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=
AI_MODERATION_MODE=stub

# === PDF → Image (Ghostscript) ===
# Kosong = auto-detect /usr/bin/gs di Linux. Set kalau gs di lokasi non-standar.
GHOSTSCRIPT_BIN=

# === Bisnis (PRD section 6) ===
PLATFORM_COMMISSION_PERCENT=20
PRICE_MIN=15000
PRICE_MAX=500000
PAYOUT_DAY=5
PAYOUT_THRESHOLD=100000
COOLING_DAYS=7
TRANSFER_FEE=6500
PPH23_WITH_NPWP=2
PPH23_NO_NPWP=4

VITE_APP_NAME="${APP_NAME}"
