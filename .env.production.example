#
# bukudigi.com — Production .env template
# Copy ke `.env` di VPS, lalu isi value-nya.
#

APP_NAME=bukudigi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://bukudigi.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# === Database (MariaDB) ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bukudigi
DB_USERNAME=bukudigi
DB_PASSWORD=GANTI-PASSWORD-KUAT

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=bukudigi

# === Mail (Brevo / Mailgun / SMTP lainnya) ===
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@bukudigi.com"
MAIL_FROM_NAME="${APP_NAME}"

# === Cloudflare R2 (storage — setup di STORAGE-SETUP.md) ===
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_ENDPOINT=
R2_PUBLIC_BUCKET=bukudigi-public
R2_PRIVATE_BUCKET=bukudigi-private
R2_BACKUP_BUCKET=bukudigi-backups
R2_PUBLIC_URL=https://cdn.bukudigi.com

# === Google OAuth (opsional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# === Fonnte WhatsApp (stub sampai SIM card siap) ===
FONNTE_MODE=stub
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send

# === Midtrans (stub sampai aplikasi merchant disetujui) ===
MIDTRANS_MODE=stub
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# === AI Moderasi (opsional — kalau kosong, admin moderasi manual) ===
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=
AI_MODERATION_MODE=stub

# === PDF → Image (Ghostscript) ===
# Kosong = auto-detect /usr/bin/gs di Linux. Set kalau gs di lokasi non-standar.
GHOSTSCRIPT_BIN=

# === Bisnis (PRD section 6) ===
PLATFORM_COMMISSION_PERCENT=20
PRICE_MIN=15000
PRICE_MAX=500000
PAYOUT_DAY=5
PAYOUT_THRESHOLD=100000
COOLING_DAYS=7
TRANSFER_FEE=6500
PPH23_WITH_NPWP=2
PPH23_NO_NPWP=4

VITE_APP_NAME="${APP_NAME}"
